{
  "name": "browser-bridge",
  "version": "1.1.280",
  "private": true,
  "type": "module",
  "description": "Drive the browser you are signed into through a paired Chromium extension: ten tools over the DevTools Protocol.",
  "exports": {
    ".": "./index.js",
    "./bridge": "./bridge.js",
    "./tools": "./tools.js",
    "./icon": "./icon.svg",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "index.js",
    "http-adapter.js",
    "tests/fixture.html",
    "tests/fixture-inner.html",
    "tests/fixture-deep.html",
    "tests/arcade.html",
    "client.js",
    "bridge.js",
    "tools.js",
    "skill/**",
    "extension/**",
    "scripts/**",
    "icon.svg",
    "images/**",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "author": {
    "name": "Jidaron"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jidaron/dsh-browser-bridge.git"
  },
  "homepage": "https://github.com/Jidaron/dsh-browser-bridge#readme",
  "bugs": {
    "url": "https://github.com/Jidaron/dsh-browser-bridge/issues"
  },
  "keywords": [
    "browser-automation",
    "chrome-extension",
    "devtools-protocol",
    "dsh-plugin",
    "ai-agents"
  ],
  "scripts": {
    "test": "node tests/selftest.mjs && node tests/compat-webserver.mjs && node tests/friction-contract.mjs"
  }
}
