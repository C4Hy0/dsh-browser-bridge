{
  "name": "browser-bridge",
  "version": "1.1.273",
  "private": true,
  "type": "module",
  "description": "Drive the browser you are signed into through a paired Chromium extension: ten tools over the DevTools Protocol.",
  "exports": {
    ".": "./index.js",
    "./bridge": "./bridge.js",
    "./tools": "./tools.js",
    "./icon": "./icon.svg",
    "./client": "./client.js"
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "index.js",
    "http-adapter.js",
    "tests/fixture.html",
    "tests/fixture-inner.html",
    "tests/fixture-deep.html",
    "tests/arcade.html",
    "client.js",
    "bridge.js",
    "tools.js",
    "skill/**",
    "extension/**",
    "scripts/**",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
